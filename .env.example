COMPOSE_PROJECT_NAME=business-platform

# Shared PostgreSQL database used by both ERP and POS.
POSTGRES_VERSION=17
POSTGRES_DB=erp_pos
POSTGRES_USER=erp_pos
POSTGRES_PASSWORD=change-me-please
POSTGRES_VOLUME_NAME=erp_pos_postgres_data

# Base runtime mode
APP_ENV=development
POS_ENVIRONMENT=development

# ERP backend security
REGISTER_KEY=change-me
JWT_SECRET_KEY=change-this-erp-jwt-secret-to-32-plus-chars
SECRET_KEY=change-this-erp-secret-to-32-plus-chars

# POS backend security
POS_SECRET_KEY=change-this-pos-secret-to-32-plus-chars
POS_JWT_SECRET_KEY=

# Shared notification / integration defaults
EMAIL_ENABLED=false
SMS_ENABLED=false
TWILIO_ENABLED=false
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
DEFAULT_CUSTOMER_COUNTRY_CODE=+91

# ERP app routing
ERP_PUBLIC_BASE_URL=http://localhost:8080
ERP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ERP_TRUSTED_HOSTS=localhost,127.0.0.1
ERP_MEDIA_BASE_URL=auto
ERP_WEB_API_URL=same-origin
ERP_WEB_API_PORT=8001
ERP_WEB_API_VERSION_PATH=/api/v1
ERP_WEB_PORT=8080
ERP_CLIENT_MAX_BODY_SIZE=10m
ERP_RATE_LIMIT_ENABLED=false
ERP_NOTIFICATION_WORKER_ENABLED=true

# POS app routing
POS_INVOICE_PUBLIC_BASE_URL=http://localhost:8081
POS_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
POS_TRUSTED_HOSTS=localhost,127.0.0.1
POS_MEDIA_BASE_URL=auto
POS_WEB_API_URL=same-origin
POS_WEB_API_PORT=8000
POS_WEB_API_VERSION_PATH=/api/v1
POS_WEB_REQUEST_TIMEOUT_MS=15000
POS_WEB_PORT=8081
POS_CLIENT_MAX_BODY_SIZE=16m
POS_ENABLE_HTTPS_REDIRECT=false
POS_RATE_LIMIT_ENABLED=false
POS_NOTIFICATION_WORKER_ENABLED=true
POS_NOTIFICATION_WORKER_INTERVAL_SECONDS=10
POS_NOTIFICATION_BATCH_SIZE=20

# Shared auth / logging tuning
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
LOG_FORMAT=text
BACKGROUND_WORKER_INTERVAL=10
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_RETRY_SCHEDULE_SECONDS=60,300,900,1800,3600,21600

# Optional AWS production override values used by compose.aws.yaml
ERP_DOMAIN=
POS_DOMAIN=
