ENVIRONMENT=development
APP_NAME=ERP Backend
HOST=0.0.0.0
PORT=8001

DATABASE_URL=postgresql://user:password@host:5432/database
AUTO_CREATE_TABLES=false
ALLOW_DEV_SEED=false

# Local/LAN example:
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.10:8081
# TRUSTED_HOSTS=localhost,127.0.0.1,192.168.1.10
# Production example:
# CORS_ORIGINS=https://erp.your-domain.com
# TRUSTED_HOSTS=erp-api.your-domain.com,erp.your-domain.com
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
TRUSTED_HOSTS=localhost,127.0.0.1

REGISTER_KEY=change-me
SECRET_KEY=change-this-to-a-strong-secret-at-least-32-chars
JWT_SECRET_KEY=change-this-to-a-strong-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

MEDIA_BASE_URL=auto
UPLOAD_DIR=uploads
STATIC_DIR=static

LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=logs/erp-backend.log
RATE_LIMIT_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_ENABLED=false

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

NOTIFICATION_WORKER_ENABLED=true
BACKGROUND_WORKER_INTERVAL=10
