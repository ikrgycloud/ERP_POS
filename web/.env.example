# Local/LAN development:
# - Use auto so the web app calls the same host you opened in the browser.
# - http://localhost:5174 -> http://localhost:8001/api/v1
# - http://192.168.29.189:5174 -> http://192.168.29.189:8001/api/v1
# Local: EXPO_PUBLIC_API_URL=auto
# Production: EXPO_PUBLIC_API_URL=https://erp.vee-gpt.com/api/v1
EXPO_PUBLIC_API_URL=https://erp.vee-gpt.com/api/v1
EXPO_PUBLIC_API_PORT=8001
EXPO_PUBLIC_API_VERSION_PATH=/api/v1

# Production:
# EXPO_PUBLIC_API_URL=https://erp.your-domain.com/api/v1
