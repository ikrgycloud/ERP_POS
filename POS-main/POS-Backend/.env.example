APP_NAME=POS + ERP API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql://erp_pos:change-me@localhost:5432/erp_pos
AUTO_CREATE_TABLES=false
SECRET_KEY=change-me-32-characters-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=https://pos.example.com
TRUSTED_HOSTS=pos.example.com,localhost,127.0.0.1
ENABLE_HTTPS_REDIRECT=true
RATE_LIMIT_ENABLED=true

INVOICE_PUBLIC_BASE_URL=https://pos.example.com
MEDIA_BASE_URL=https://pos.example.com
UPLOAD_DIR=uploads

SMS_ENABLED=false
WHATSAPP_ENABLED=false
NOTIFICATION_WORKER_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
